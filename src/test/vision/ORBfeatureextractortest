package com.smartdoc.vision;

import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;

import java.awt.Color;
import java.awt.Graphics2D;
import java.awt.image.BufferedImage;
import java.nio.file.Files;
import java.nio.file.Path;
import javax.imageio.ImageIO;

/**
 * Unit tests for ORBFeatureExtractor.
 *
 * TC-ORB-01: Non-null FeatureResult returned for a rich image
 * TC-ORB-02: keypointsCount >= 0 (never negative)
 * TC-ORB-03: Same image produces identical keypoint count twice
 * TC-ORB-04: Blank image produces fewer keypoints than a structured image
 * TC-ORB-05: extractFeatures(Path) works for a temp PNG file
 */
@DisplayName("ORBFeatureExtractor Unit Tests")
class ORBFeatureExtractorTest {

    private ORBFeatureExtractor extractor;

    @BeforeEach
    void setUp() {
        extractor = new ORBFeatureExtractor();
    }

    // -------------------------------------------------------------------------
    // TC-ORB-01
    // -------------------------------------------------------------------------
    @Test
    @DisplayName("TC-ORB-01: FeatureResult is non-null for a structured image")
    void testFeatureResultNotNull() throws Exception {
        BufferedImage img = createCheckeredImage(256, 256);
        ORBFeatureExtractor.FeatureResult result = extractor.extractFeatures(img);
        assertNotNull(result, "FeatureResult must never be null");
    }

    // -------------------------------------------------------------------------
    // TC-ORB-02
    // -------------------------------------------------------------------------
    @Test
    @DisplayName("TC-ORB-02: Keypoints count is never negative")
    void testKeypointsCountNonNegative() throws Exception {
        BufferedImage img = createCheckeredImage(128, 128);
        ORBFeatureExtractor.FeatureResult result = extractor.extractFeatures(img);
        assertTrue(result.getKeypointsCount() >= 0, "Keypoints count must be >= 0");
    }

    // -------------------------------------------------------------------------
    // TC-ORB-03
    // -------------------------------------------------------------------------
    @Test
    @DisplayName("TC-ORB-03: Same image always produces same keypoint count (determinism)")
    void testDeterministicKeypoints() throws Exception {
        BufferedImage img = createCheckeredImage(200, 200);
        int kp1 = extractor.extractFeatures(img).getKeypointsCount();
        int kp2 = extractor.extractFeatures(img).getKeypointsCount();
        assertEquals(kp1, kp2, "ORB must be deterministic for the same input");
    }

    // -------------------------------------------------------------------------
    // TC-ORB-04
    // -------------------------------------------------------------------------
    @Test
    @DisplayName("TC-ORB-04: Structured image produces >= keypoints than blank image")
    void testStructuredVsBlankKeypoints() throws Exception {
        BufferedImage blank = new BufferedImage(256, 256, BufferedImage.TYPE_INT_RGB);
        Graphics2D g = blank.createGraphics();
        g.setColor(Color.WHITE);
        g.fillRect(0, 0, 256, 256);
        g.dispose();

        BufferedImage structured = createCheckeredImage(256, 256);
        int kpBlank = extractor.extractFeatures(blank).getKeypointsCount();
        int kpStructured = extractor.extractFeatures(structured).getKeypointsCount();
        assertTrue(kpStructured >= kpBlank,
            "Structured image should have >= keypoints compared to blank image");
    }

    // -------------------------------------------------------------------------
    // TC-ORB-05
    // -------------------------------------------------------------------------
    @Test
    @DisplayName("TC-ORB-05: extractFeatures(Path) works for a saved PNG file")
    void testFeatureExtractionFromPath() throws Exception {
        BufferedImage img = createCheckeredImage(200, 200);
        Path tmp = Files.createTempFile("orb_test_", ".png");
        ImageIO.write(img, "png", tmp.toFile());

        ORBFeatureExtractor.FeatureResult result = extractor.extractFeatures(tmp);
        assertNotNull(result);
        assertTrue(result.getKeypointsCount() >= 0);
        Files.deleteIfExists(tmp);
    }

    // -------------------------------------------------------------------------
    // Helper – creates a high-contrast checkered pattern that ORB can work on
    // -------------------------------------------------------------------------
    private BufferedImage createCheckeredImage(int w, int h) {
        BufferedImage img = new BufferedImage(w, h, BufferedImage.TYPE_INT_RGB);
        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {
                boolean white = ((x / 16) + (y / 16)) % 2 == 0;
                img.setRGB(x, y, white ? Color.WHITE.getRGB() : Color.BLACK.getRGB());
            }
        }
        return img;
    }
}
